# Base URL of the server API (proxied to the Go server by Vite in development)
VITE_API_BASE_URL=/api/v1
# Keycloak realm that issues tokens: <KEYCLOAK_PUBLIC_URL>/realms/<KEYCLOAK_REALM> from server/cmd/server/.env
VITE_OIDC_AUTHORITY=http://localhost:8080/auth/realms/slot-finder
# Public client of the web app in that realm (KEYCLOAK_SPA_CLIENT_ID)
VITE_OIDC_CLIENT_ID=slot-finder-web

        <mxCell id="v-3" value="Planner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="240" y="60" width="140" height="50" />
        </mxCell>
        <mxCell id="v-4" value="Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="60" width="140" height="50" />
        </mxCell>
        <mxCell id="v-5" value="Server API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="60" width="140" height="50" />
        </mxCell>
        <mxCell id="v-6" value="Planning Engine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="60" width="140" height="50" />
        </mxCell>
        <mxCell id="v-7" value="Database" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="960" y="60" width="140" height="50" />
        </mxCell>
        <mxCell id="v-8" value="Worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1140" y="60" width="140" height="50" />
        </mxCell>
        <mxCell id="l-9" value="1. Add project to program + demand (expertise, level, budget hours, deadline)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="130" y="150" />
            <mxPoint as="targetPoint" x="490" y="150" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-10" value="2. POST /programs/{id}/projects, PUT /projects/{id}/demands" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="490" y="192" />
            <mxPoint as="targetPoint" x="670" y="192" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-11" value="3. Save project (status = incoming)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="670" y="234" />
            <mxPoint as="targetPoint" x="1030" y="234" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-12" value="4. Ask for a staffing draft for the project" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="310" y="276" />
            <mxPoint as="targetPoint" x="490" y="276" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-13" value="5. POST /staffing-drafts {projectIds}" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="490" y="318" />
            <mxPoint as="targetPoint" x="670" y="318" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-14" value="6. Read snapshot (members, skills, capacity, baseline)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="670" y="360" />
            <mxPoint as="targetPoint" x="1030" y="360" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-15" value="7. propose(snapshot, policy)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="670" y="402" />
            <mxPoint as="targetPoint" x="850" y="402" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-16" value="8. assignments (kind + reason) + weekly hours + unmet" style="html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="850" y="444" />
            <mxPoint as="targetPoint" x="670" y="444" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-17" value="9. Save plan kind=draft, status=draft" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="670" y="486" />
            <mxPoint as="targetPoint" x="1030" y="486" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-18" value="10. Staffing draft" style="html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="670" y="528" />
            <mxPoint as="targetPoint" x="490" y="528" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-19" value="11. Review, edit, lock" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="310" y="570" />
            <mxPoint as="targetPoint" x="490" y="570" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-20" value="12. POST /staffing-drafts/{id}/accept {baseVersion}" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="490" y="612" />
            <mxPoint as="targetPoint" x="670" y="612" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-21" value="13. Transaction: publish new baseline, old one becomes superseded" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="670" y="654" />
            <mxPoint as="targetPoint" x="1030" y="654" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-22" value="14. 200 OK, or 409 if the baseline changed" style="html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="670" y="696" />
            <mxPoint as="targetPoint" x="490" y="696" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-23" value="15. enqueue notify" style="html=1;endArrow=open;endFill=0;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="670" y="738" />
            <mxPoint as="targetPoint" x="1210" y="738" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-24" value="16. Notify members and the program's assistants" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1210" y="780" />

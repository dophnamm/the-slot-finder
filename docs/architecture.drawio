        <mxCell id="v-183" value="created_at&amp;nbsp;&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="v-180">
          <mxGeometry as="geometry" x="0" y="72" width="320" height="22" />
        </mxCell>
        <mxCell id="v-179" value="&lt;b&gt;Derived, not stored&lt;/b&gt;&lt;br&gt;• capacity(person, week) = weekly_hours(week) − non_project_hours − absence hours; 0 outside start/end (shared by all expertises)&lt;br&gt;• weekly_hours(week) = latest CAPACITY_CHANGE on or before the week, else PERSON.weekly_hours&lt;br&gt;• absence = own leave + holidays of the person's location + company-wide; planned absence per config&lt;br&gt;• load = Σ allocation.hours of all assignments in the baseline; also split by expertise&lt;br&gt;• budget = Σ DEMAND.total_hours · planned = Σ baseline allocations&lt;br&gt;• forecast = override if set, else planned · gap = budget − forecast&lt;br&gt;• demand window = its phase's weeks, or project start → deadline&lt;br&gt;&lt;br&gt;&lt;b&gt;ASSIGNMENT.kind&lt;/b&gt; is set by the server: primary skill → primary, other skill ≥ min_level → cross_expertise, below level → stretch (Planner only)&lt;br&gt;&lt;b&gt;DEMAND_TAG.kind:&lt;/b&gt; required = hard constraint, preferred = soft (tag_fit)&lt;br&gt;&lt;b&gt;Phase slip:&lt;/b&gt; a later end_week shifts every later phase by the same weeks (PhaseSlipped)&lt;br&gt;&lt;b&gt;Leave from calendars:&lt;/b&gt; an out-of-office event in a CALENDAR_FEED becomes planned leave (source = calendar, external_uid = event UID); each sync makes it match the calendar&lt;br&gt;&lt;b&gt;ACTUAL_HOURS:&lt;/b&gt; one row per person × project × ISO week from a timesheet import; feeds Actual hours and Burn %, never planning" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffde7;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="1176" width="640" height="320" />
        </mxCell>

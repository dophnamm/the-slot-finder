  <diagram id="5-flow---new-project-to-staffing" name="5. Flow - New project to staffing">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v-1" value="5. Flow: New project → staffing draft → approval" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="10" width="900" height="30" />
        </mxCell>
        <mxCell id="v-2" value="Program Lead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="60" width="140" height="50" />

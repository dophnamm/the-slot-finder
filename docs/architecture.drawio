          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="490" y="192" />
            <mxPoint as="targetPoint" x="670" y="192" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-11" value="3. Save project (status = incoming)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">

  <diagram id="6-flow---change-to-replan" name="6. Flow - Change to Replan">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v-1" value="6. Flow: A change happens → re-plan" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="10" width="900" height="30" />
        </mxCell>
        <mxCell id="v-2" value="Specialist / Lead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="60" width="140" height="50" />
        </mxCell>
        <mxCell id="v-3" value="Server API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="300" y="60" width="140" height="50" />
        </mxCell>
        <mxCell id="v-4" value="Worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="540" y="60" width="140" height="50" />
        </mxCell>
        <mxCell id="v-5" value="Planning Engine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="60" width="140" height="50" />
        </mxCell>
        <mxCell id="v-6" value="Planner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1020" y="60" width="140" height="50" />
        </mxCell>
        <mxCell id="l-7" value="1. Report leave / move a phase end or a deadline" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="130" y="150" />
            <mxPoint as="targetPoint" x="370" y="150" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-8" value="2. Save change (shift later phases) + record ChangeEvent" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="370" y="192" />
            <mxPoint as="targetPoint" x="370" y="212" />
            <Array as="points">
              <mxPoint x="410" y="192" />
              <mxPoint x="410" y="212" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="l-9" value="3. enqueue replan(event)" style="html=1;endArrow=open;endFill=0;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="370" y="246" />
            <mxPoint as="targetPoint" x="610" y="246" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-10" value="4. Wait REPLAN_DEBOUNCE, batch the events" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="610" y="288" />
            <mxPoint as="targetPoint" x="610" y="308" />
            <Array as="points">
              <mxPoint x="650" y="288" />
              <mxPoint x="650" y="308" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="l-11" value="5. Assess impact (overloaded weeks, understaffed projects)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="610" y="342" />
            <mxPoint as="targetPoint" x="610" y="362" />
            <Array as="points">
              <mxPoint x="650" y="342" />
              <mxPoint x="650" y="362" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="l-12" value="6. Mark events as no_impact" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="610" y="426" />
            <mxPoint as="targetPoint" x="370" y="426" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-13" value="7. replan(snapshot, keep locked, minimal change)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="610" y="498" />
            <mxPoint as="targetPoint" x="850" y="498" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-14" value="8. Staffing draft + diff against the baseline" style="html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="850" y="540" />
            <mxPoint as="targetPoint" x="610" y="540" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-15" value="9. Save draft, link the events to it" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="610" y="582" />
            <mxPoint as="targetPoint" x="370" y="582" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-16" value="10. Alert + link to the diff" style="html=1;endArrow=open;endFill=0;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="610" y="624" />
            <mxPoint as="targetPoint" x="1090" y="624" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-17" value="11. replan(baseline + all linked events, keep edits and locks)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="610" y="696" />
            <mxPoint as="targetPoint" x="850" y="696" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l-18" value="12. New draft version + diff" style="html=1;endArrow=open;endFill=0;dashed=1;verticalAlign=bottom;fontSize=11;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="850" y="738" />
            <mxPoint as="targetPoint" x="610" y="738" />

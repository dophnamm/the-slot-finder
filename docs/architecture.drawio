          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="v-120" value="&lt;b&gt;Derived, not stored&lt;/b&gt;&lt;br&gt;• capacity(person, week) = weekly_hours − leave hours&lt;br&gt;• load = Σ allocation.hours in the baseline; utilization = load ÷ capacity&lt;br&gt;• budget = Σ DEMAND.total_hours · planned = Σ baseline allocations&lt;br&gt;• forecast = override if set, else planned · gap = budget − forecast&lt;br&gt;• Time %, Scope %, Cost %, Staffing %: see README section 7&lt;br&gt;&lt;br&gt;• demand window = its phase's weeks, or project start → deadline&lt;br&gt;&lt;br&gt;&lt;b&gt;PLAN.parent_id&lt;/b&gt; points to the base plan: baseline → draft / scenario&lt;br&gt;&lt;b&gt;Phase slip:&lt;/b&gt; a later end_week shifts every later phase by the same weeks (PhaseSlipped)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffde7;strokeColor=#c9b458;align=left;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1000" width="520" height="170" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="5-flow---new-project-to-staffing" name="5. Flow - New project to staffing">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">

            <Array as="points">
              <mxPoint x="1250" y="780" />
              <mxPoint x="1250" y="800" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="l-25" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">

{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Staffing and capacity planning API for The Slot Finder",
        "title": "The Slot Finder API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/": {
            "get": {
                "description": "Check if the service is running",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health Check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "data": {
                                    "$ref": "#/definitions/dtos.HealthResponse"
                                },
                                "meta": {
                                    "$ref": "#/definitions/dtos.Meta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health/database": {
            "get": {
                "description": "Check if the database connection is healthy",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Database Health Check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "data": {
                                    "type": "object"
                                },
                                "meta": {
                                    "$ref": "#/definitions/dtos.Meta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health/metrics": {
            "get": {
                "description": "Get detailed database connection metrics",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Database Connection Metrics",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "data": {
                                    "type": "object"
                                },
                                "meta": {
                                    "$ref": "#/definitions/dtos.Meta"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "The signed-in user, read from the verified access token: id, username, name, email and role.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Identity"
                ],
                "summary": "Current user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "data": {
                                    "$ref": "#/definitions/dtos.CurrentUserResponse"
                                },
                                "meta": {
                                    "$ref": "#/definitions/dtos.Meta"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "meta": {
                                    "$ref": "#/definitions/dtos.Meta"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "meta": {
                                    "$ref": "#/definitions/dtos.Meta"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dtos.CurrentUserResponse": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "planner@slot-finder.local"
                },
                "id": {
                    "type": "string",
                    "example": "5b0c2b7e-4c1e-4a43-9b8e-0b1f2f6f8a10"
                },
                "name": {
                    "type": "string",
                    "example": "Pat Planner"
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "planner",
                        "lead",
                        "specialist"
                    ],
                    "example": "planner"
                },
                "username": {
                    "type": "string",
                    "example": "planner"
                }
            }
        },
        "dtos.HealthResponse": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string",
                    "example": "slot-finder"
                },
                "status": {
                    "type": "string",
                    "example": "healthy"
                },
                "timestamp": {
                    "type": "string",
                    "example": "2021-01-01T00:00:00Z"
                },
                "version": {
                    "type": "string",
                    "example": "1.0.0"
                }
            }
        },
        "dtos.Meta": {
            "description": "Metadata for pagination",
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 400
                },
                "error_code": {
                    "type": "string",
                    "example": "BAD_REQUEST"
                },
                "message": {
                    "type": "string",
                    "example": "Request is invalid"
                },
                "page": {
                    "type": "integer",
                    "example": 1
                },
                "page_size": {
                    "type": "integer",
                    "example": 20
                },
                "total": {
                    "type": "integer",
                    "example": 18
                }
            }
        }
    },
    "securityDefinitions": {
        "BasicAuth": {
            "type": "basic"
        },
        "BearerAuth": {
            "description": "Bearer Token Authentication. Use \"Bearer {token}\" as the value.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}
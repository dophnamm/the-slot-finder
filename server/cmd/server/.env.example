# Application
APP_ENV="development"
APP_NAME="slot-finder"
TIMEZONE="UTC"
APP_HTTP_SERVER=":3000"
APP_REQUEST_TIMEOUT=30
# HTTP server limits; the write timeout must outlast the slowest handler (the longest is a calendar fetch, CALENDAR_FETCH_TIMEOUT, plus database time)
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=120s
HTTP_IDLE_TIMEOUT=120s
# Largest request body in bytes (larger requests get 413)
APP_BODY_LIMIT_BYTES=2097152
# true behind a reverse proxy: take the client IP from X-Forwarded-For (private/loopback proxies only)
HTTP_TRUST_PROXY=false

# Logging: debug | info | warn | error. Format follows APP_ENV (console in development, JSON in production).
LOG_LEVEL="info"
# Longest request body written to the request log, in bytes
LOG_BODY_MAX_BYTES=2048

# Outbound HTTP client
HTTP_CLIENT_TIMEOUT=30s
HTTP_CLIENT_RETRY_COUNT=2
HTTP_CLIENT_RETRY_WAIT_MIN=250ms
HTTP_CLIENT_RETRY_WAIT_MAX=2s
HTTP_CLIENT_DEBUG=false
HTTP_CLIENT_TLS_INSECURE_SKIP_TLS=false

# Rate limit: RATE_LIMIT requests per RATE_LIMIT_DURATION per client IP (0 turns it off)
RATE_LIMIT=20
RATE_LIMIT_DURATION=1s
RATE_LIMIT_HEAVY=20
RATE_LIMIT_HEAVY_DURATION=30s

# Keycloak (used by the API, and by deploy/keycloak/realm.json when the realm is imported)
KEYCLOAK_REALM=slot-finder
# URL the server uses to reach Keycloak (compose overrides it with the container name)
KEYCLOAK_URL=http://localhost:8080/auth
# URL the browser uses; tokens carry it in their issuer
KEYCLOAK_PUBLIC_URL=http://localhost:8080/auth
# Confidential client of this API; tokens for the API list it in their audience
KEYCLOAK_CLIENT_ID=slot-finder-api
KEYCLOAK_CLIENT_SECRET=dev-only-api-secret
# Public client of the web app (Authorization Code + PKCE)
KEYCLOAK_SPA_CLIENT_ID=slot-finder-web
KEYCLOAK_REDIRECT_URI=
# Web app URL: allowed redirect, logout and CORS origin of the web app client
CLIENT_APP_URL=http://localhost:5173
# Password of the demo users planner, manager and specialist. Development only.
KEYCLOAK_DEMO_PASSWORD=P@ssw0rd123
# Theme of the sign-in pages (deploy/keycloak/themes); `make keycloak-theme` applies it to an existing realm
KEYCLOAK_LOGIN_THEME=slot-finder

# Local JWT verification against the realm's JWKS
AUTH_JWKS_REFRESH_INTERVAL=1h
# Shortest gap between refetches triggered by an unknown key id
AUTH_JWKS_UNKNOWN_KID_INTERVAL=1m
# Longest a request waits for such a refetch
AUTH_JWKS_REFRESH_WAIT_MAX=1s
AUTH_CLOCK_SKEW=30s

# Capacity per person and week
# Days that count, e.g. Mon,Tue,Wed,Thu,Fri
WORKING_WEEKDAYS=Mon,Tue,Wed,Thu,Fri
# Weekly hours kept for meetings, support and management when a person is created without a value
DEFAULT_NON_PROJECT_HOURS=4
# Whether planned (not yet approved) absence lowers capacity; approved absence always does
COUNT_PLANNED_ABSENCE=true

# How many weeks from the current week a project date or phase week may lie, in either direction
PROJECT_WINDOW_WEEKS=156

# Planning policy for staffing drafts (server/README §8). HOUR_STEP rounds weekly hours (0 = exact).
PLANNING_TARGET_UTILIZATION=0.8
PLANNING_MAX_UTILIZATION=1.0
PLANNING_MAX_EXPERTISES_PER_PERSON_WEEK=2
PLANNING_MIN_HOURS_PER_WEEK=8
PLANNING_HOUR_STEP=1
PLANNING_WEIGHT_DEADLINE=1.0
PLANNING_WEIGHT_PRIMARY_FIT=0.8
PLANNING_WEIGHT_BALANCE=0.6
PLANNING_WEIGHT_STABILITY=0.5
PLANNING_WEIGHT_CONTINUITY=0.3
PLANNING_WEIGHT_LEVEL_FIT=0.4
# People a staffing draft offers to swap in for an assignment
DRAFT_ALTERNATIVES_LIMIT=5

# Team heatmap: weeks shown by default, the widest range allowed, and the utilization bands
# (underused below, near full from; overloaded is always over 100 %)
HEATMAP_DEFAULT_WEEKS=12
HEATMAP_MAX_WEEKS=52
UTILIZATION_UNDERUSED_BELOW=0.5
UTILIZATION_NEAR_FULL_FROM=0.85

# Member calendar: the widest range of one person's schedule (a month grid needs at most 6 weeks)
SCHEDULE_MAX_WEEKS=8

# Re-plan on change: events closer together than REPLAN_DEBOUNCE are handled in one run
# (5m in production; short here for local demos). Failed runs retry after BACKOFF × attempts.
REPLAN_DEBOUNCE=30s
REPLAN_POLL_INTERVAL=10s
REPLAN_BATCH_SIZE=50
REPLAN_MAX_ATTEMPTS=5
REPLAN_RETRY_BACKOFF=30s
PLANNING_REPLAN_STABILITY_WEIGHT=2.0

# What-if scenarios: the most weeks a project may move, and the most assumptions per scenario
SCENARIO_MAX_SHIFT_WEEKS=12
SCENARIO_MAX_ASSUMPTIONS=10

# Timesheet import: weeks in the template by default and at most, the most actual hours one
# row may hold, and the largest file in bytes and rows
TIMESHEET_TEMPLATE_WEEKS=4
TIMESHEET_MAX_WEEKS=12
TIMESHEET_MAX_WEEK_HOURS=80
TIMESHEET_MAX_BYTES=1048576
TIMESHEET_MAX_ROWS=5000

# People import: the largest file in bytes and rows
PEOPLE_IMPORT_MAX_BYTES=1048576
PEOPLE_IMPORT_MAX_ROWS=1000

# Calendar sync (docs/features/calendar-sync.md). An empty key turns the feature off.
# Make a key with: openssl rand -base64 32  (a secret: never commit a real one)
CALENDAR_FEED_KEY=
CALENDAR_ALLOWED_HOSTS=calendar.google.com,outlook.office365.com,outlook.live.com
CALENDAR_SYNC_INTERVAL=15m
CALENDAR_SYNC_BATCH_SIZE=20
CALENDAR_SYNC_WEEKS=26
CALENDAR_LEAVE_KEYWORDS="OOO,Out of office,Vacation,Annual leave,Nghỉ phép"
CALENDAR_FETCH_TIMEOUT=10s
CALENDAR_MAX_BYTES=5242880

# Program metrics: percentage points Scope % may trail Time % before "behind on delivery",
# and how many weeks before a deadline a staffing gap counts as "at risk"
SCOPE_LAG_THRESHOLD=20
ALERT_HORIZON_WEEKS=4
# Weeks in a row over 100 % that make a sustained overload in the risks list
SUSTAINED_OVERLOAD_WEEKS=3
# Weeks ahead a person must stay underused to be on the bench list
BENCH_WEEKS=4
# Percent weight of an incoming project's demand in the capacity forecast
PIPELINE_CONFIDENCE_PERCENT=50

# PostgreSQL (used by the API, the Makefile migrations and the postgres container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Redis (the compose container has no password)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Email (AWS SES)
EMAIL_PROVIDER="ses"
AWS_SES_REGION="ap-southeast-1"
AWS_SES_ACCESS_KEY=""
AWS_SES_SECRET_KEY=""
# Verified sender address (the From of every email)
AWS_SES_FROM_EMAIL=""

# Swagger UI basic auth (non-production only)
BASIC_AUTH_USER="backend"
BASIC_AUTH_SECRET="admin"

# Sentry (optional; empty disables it)
SENTRY_DSN=""

# OpenTelemetry (OTLP). Local stack: make otel-up
OTEL_SERVICE_NAME=slot-finder
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_LOGS_ENABLED=true

# Keycloak container (read by docker compose)
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=postgres
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_ENABLED=true
KC_HTTP_RELATIVE_PATH=/auth
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Ask AI. LLM_PROVIDER picks the provider (gemini, groq or openrouter); each has its own key and model, so
# switching provider means changing this one line. Leave the chosen provider's key blank to turn the feature off.
LLM_PROVIDER=gemini
# Gemini (Google AI Studio key). Blank model uses the default; model IDs change, confirm in AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
# Groq (Groq API key). Blank model uses the default; confirm the ID in the Groq console.
GROQ_API_KEY=
GROQ_MODEL=
# OpenRouter (OpenRouter API key). Blank model uses openrouter/free, which picks a free model that can call tools;
# model IDs change, confirm on openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Timeout of one model call
LLM_TIMEOUT=30s
# Most model calls one question may take (each tool round is one call)
LLM_MAX_TOOL_ROUNDS=5
# Longest tool result sent back to the model, in bytes; a longer one is shrunk (empty values dropped, long lists trimmed)
LLM_MAX_TOOL_RESULT_BYTES=8000
# Sampling temperature sent to every provider; low means the same question gets a consistent answer
LLM_TEMPERATURE=0.2
